{
  "name": "kilik-soygunu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5184 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "release": "npm run build && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force release | Out-Null; Compress-Archive -Path dist/* -DestinationPath release/kilik-soygunu-poki.zip -Force\""
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "three": "^0.187.0"
  }
}
